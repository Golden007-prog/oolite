{
    "mesonbuild.buildFolder": "build/meson_debug",
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/meson_debug",
        "--background-index",
        "--header-insertion=never"
    ],
    "debug.allowBreakpointsEverywhere": true,
    "files.associations": {
        "*.m": "objective-c",
        "*.h": "objective-c"
    },
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/meson_debug/compile_commands.json",
    "C_Cpp.default.configurationProvider": "mesonbuild.mesonbuild"
}